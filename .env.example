# CleanPix - Cloudinary Configuration (Server-Side Only)
# Copy this file to .env.local and fill in your values.
# DO NOT add NEXT_PUBLIC_ prefix to secrets!

CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_api_key_here"
CLOUDINARY_API_SECRET="your_api_secret_here"

# Alternative combined format (optional):
# CLOUDINARY_URL="cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>"

# PostgreSQL Database Connection (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cleanpix?schema=public"

# NextAuth / Auth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate_a_random_32_character_secret_key"

# Google OAuth Provider (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Email / Magic Link Provider (SMTP Server)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your_smtp_user"
EMAIL_SERVER_PASSWORD="your_smtp_password"
EMAIL_FROM="CleanPix <no-reply@cleanpix.app>"

# Razorpay Phase 1 One-Time Payment Gateway (https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_AMOUNT="9900" # Amount in smallest unit (9900 paise = ₹99 INR)
RAZORPAY_CURRENCY="INR"
