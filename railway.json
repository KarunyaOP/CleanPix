{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ai-worker/Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m uvicorn main:app --app-dir ai-worker --host 0.0.0.0 --port $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
